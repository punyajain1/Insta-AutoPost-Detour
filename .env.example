# Database
DATABASE_URL="postgresql://user:password@localhost:5432/detour"

# Server
PORT=4000
NODE_ENV=development
CRON_SECRET="my-super-secret-cron-password"

# ImageKit (For storing generated images)
IMAGEKIT_PUBLIC_KEY="public_key_here"
IMAGEKIT_PRIVATE_KEY="private_key_here"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint"

# Buffer (For scheduling Instagram posts)
BUFFER_ACCESS_TOKEN="your_buffer_access_token"
BUFFER_IG_PROFILE_ID="your_buffer_ig_profile_id"
